# ==========================================
# PostgreSQL Database
# ==========================================
POSTGRES_DB=manga_rental_db
POSTGRES_USER=manga_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=db_postgres
POSTGRES_PORT=5432

# ==========================================
# Django Backend
# ==========================================
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change_this_to_a_random_secret_key
DEBUG=True
# Comma-separated list, e.g. localhost,127.0.0.1,yourdomain.com (leave blank to allow all in DEBUG)
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================================
# Frontend (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000

# ==========================================
# Ports (host machine) — change if these ports are already in use
# ==========================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5433
