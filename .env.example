# ==========================================
# PostgreSQL Database
# ==========================================
POSTGRES_DB=manga_rental_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=db_postgres
POSTGRES_PORT=5432

# ==========================================
# Django Backend
# ==========================================
# Generate a new one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change_this_to_a_random_secret_key
# IMPORTANT: set DEBUG=False before deploying anywhere other than your own machine.
# DEBUG=True exposes verbose stack traces to any visitor and also relaxes CORS
# below unless CORS_ALLOW_ALL_ORIGINS is set explicitly.
DEBUG=True
# Comma-separated list, e.g. localhost,127.0.0.1,yourdomain.com (leave blank to allow all in DEBUG)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS: defaults to DEBUG's value if unset (open in dev, closed in prod).
# Uncomment to force a specific value regardless of DEBUG:
# CORS_ALLOW_ALL_ORIGINS=False
# Required when CORS_ALLOW_ALL_ORIGINS is False - comma-separated origins that
CORS_ALLOWED_ORIGINS=

# ==========================================
# Frontend (Vite)
# ==========================================
VITE_API_BASE_URL=http://localhost:8000

# ==========================================
# Ports (host machine) — change if these ports are already in use
# ==========================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5434
