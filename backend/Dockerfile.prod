FROM python:3.10-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y pkg-config default-libmysqlclient-dev build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./

# Install CPU-only PyTorch first (much smaller image), then the rest of the deps.
# The PyPI extra index is needed for torch's own build dependencies.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple torch \
    && pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

# collectstatic + migrate at startup, then serve with gunicorn on Railway's $PORT.
CMD ["sh", "-c", "python manage.py collectstatic --noinput && python manage.py migrate && gunicorn core.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 2"]
